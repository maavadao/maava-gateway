# ─────────────────────────────────────────────────────────────
# OpenClaw REST API — Environment Variables
# Copy to .env.api and fill in your values.
# ─────────────────────────────────────────────────────────────

# Gateway authentication token (required for production)
OPENCLAW_GATEWAY_TOKEN=

# ── LLM Provider API Keys (set at least one) ────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=

# ── Optional: Claude web session keys ───────────────────────
CLAUDE_AI_SESSION_KEY=
CLAUDE_WEB_SESSION_KEY=
CLAUDE_WEB_COOKIE=

# ── Port overrides (defaults shown) ─────────────────────────
# OPENCLAW_REST_PORT=3000
# OPENCLAW_GATEWAY_PORT=18789
